---
/**
 * The pointer part of the QuiteHandy toolbar (as in the app, without colours
 * and sound): pick one of six hands, drawn from all of the app's hands with a stick on every visit and every time it comes back. Appears once the hand is on screen.
 * On the emoji sheet (html[data-tool="emoji"], set by the page script) it shows emojis instead.
 * Selecting a hand dispatches `quitehandy:hand` with the image sources.
 */
import { Image } from 'astro:assets';
import RetroDialog from './RetroDialog.astro';

export interface HandChoice {
  id: string;
  label: string;
  thumb: ImageMetadata;
  src: string;
  srcset: string;
  /** Repeating slice of the stick (see the page's .hand-stick) */
  stick: string;
  /** Fingertip position as fractions of the image */
  tipX: number;
  tipY: number;
}

interface Props {
  hands: HandChoice[];
}
const { hands } = Astro.props;

const emojis = ['❤️', '👍', '😂', '🔥', '🎉', '👀', '🤔', '❌'];
---

<div class="toolbar" data-hand-toolbar>
<div class="toolbar__group toolbar__group--hands" role="toolbar" aria-label="Choose a hand">
  {
    hands.map((hand, i) => (
      <button
        class="toolbar__hand"
        type="button"
        aria-pressed={i === 0 ? 'true' : 'false'}
        hidden={i >= 6}
        data-src={hand.src}
        data-srcset={hand.srcset}
        data-stick={hand.stick}
        data-tip-x={hand.tipX}
        data-tip-y={hand.tipY}
        data-cursor-grow
      >
        <Image src={hand.thumb} width={52} height={52} densities={[1, 2, 3]} alt="" loading="lazy" />
        <span class="visually-hidden">{hand.label}</span>
      </button>
    ))
  }
  <span class="toolbar__divider" aria-hidden="true"></span>
  <button class="toolbar__add" type="button" aria-controls="own-hand" aria-haspopup="dialog" data-dialog-open="own-hand">
    <svg viewBox="0 0 20 20" aria-hidden="true">
      <path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
    </svg>
    <span class="visually-hidden">Add your own hand</span>
  </button>
</div>
<div class="toolbar__group toolbar__group--emojis" role="toolbar" aria-label="Choose an emoji">
  {
    emojis.map((emoji, i) => (
      <button
        class="toolbar__emoji"
        type="button"
        aria-pressed={i === 0 ? 'true' : 'false'}
        data-emoji={emoji}
        data-cursor-grow
      >
        {emoji}
      </button>
    ))
  }
</div>
</div>

<RetroDialog id="own-hand" title="Make your own hand">
  <p>
    In Quite Handy you can turn any idea into your own hand, for example with ChatGPT.
    Open <strong>Settings → Pointers → Make your own…</strong> and:
  </p>
  <ol>
    <li>Describe your hand, e.g. “knitted wool in mustard yellow”.</li>
    <li>
      Click <strong>Open in ChatGPT</strong> (or copy the prompt for another image tool) and download the
      result as a PNG with a transparent background.
    </li>
    <li>Drop the PNG into Quite Handy. Your hand is ready in the toolbar.</li>
  </ol>
</RetroDialog>

<script>
  const toolbar = document.querySelector<HTMLElement>('[data-hand-toolbar]');
  const pick = (button: HTMLButtonElement) => {
    toolbar?.querySelectorAll('.toolbar__hand').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
    window.dispatchEvent(new CustomEvent('quitehandy:hand', { detail: { ...button.dataset } }));
  };
  // Six of all the hands, picked anew on every visit and every time the toolbar comes back, the
  // first one in hand. `keepHand`: the one in hand stays, only the others change.
  const shuffle = (keepHand = false) => {
    if (!toolbar) return;
    const all = [...toolbar.querySelectorAll<HTMLButtonElement>('.toolbar__hand')];
    const held = all.find((b) => b.getAttribute('aria-pressed') === 'true');
    for (let i = all.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [all[i], all[j]] = [all[j], all[i]];
    }
    if (keepHand && held) {
      const at = all.indexOf(held);
      [all[0], all[at]] = [all[at], all[0]];
    } else if (held && all[0] === held) {
      // Out of sight and back: always another one.
      [all[0], all[6]] = [all[6], all[0]];
    }
    const divider = toolbar.querySelector('.toolbar__divider');
    all.forEach((b, i) => {
      b.hidden = i >= 6;
      if (i < 6) divider?.before(b);
    });
    // The first one pressed: the page's script takes it into the hand once it runs.
    pick(all[0]);
  };
  shuffle();
  window.addEventListener('quitehandy:shuffle', (event) =>
    shuffle((event as CustomEvent<{ keepHand: boolean }>).detail.keepHand),
  );
  toolbar?.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('.toolbar__hand');
    if (button) pick(button);
    const emoji = (event.target as Element).closest<HTMLButtonElement>('.toolbar__emoji');
    if (emoji) {
      toolbar.querySelectorAll('.toolbar__emoji').forEach((b) => b.setAttribute('aria-pressed', String(b === emoji)));
    }
  });
</script>

<style>
  .toolbar {
    position: fixed;
    z-index: 2; /* below the hand, above the sheets */
    left: 50%;
    bottom: 24px;
    display: grid;
    /* on phones the buttons share the width there is */
    width: max-content;
    max-width: calc(100vw - 32px);
    padding: 6px;
    /* the app's own toolbar look (deliberately not retro) */
    border-radius: 16px;
    background: rgb(28 28 30 / 0.92);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.25);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    translate: -50% calc(100% + 40px);
    opacity: 0;
    transition:
      translate 0.5s var(--ease-out),
      opacity 0.3s;
  }

  /* shown while the sheets are on screen (set by the page script) */
  :global(html[data-toolbar]) .toolbar {
    translate: -50% 0;
    opacity: 1;
  }

  /* hands and emojis on top of each other, one of them showing */
  .toolbar__group {
    grid-area: 1 / 1;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    transition:
      opacity 0.2s,
      visibility 0.2s;
  }

  :global(html:not([data-tool='emoji'])) .toolbar__group--emojis,
  :global(html[data-tool='emoji']) .toolbar__group--hands {
    opacity: 0;
    visibility: hidden;
  }

  .toolbar__emoji {
    display: grid;
    place-items: center;
    flex: 0 1 52px;
    min-width: 0;
    height: 52px;
    padding: 0;
    border: 0;
    border-radius: 10px;
    background: transparent;
    font-family: 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;
    font-size: clamp(22px, 7vw, 30px);
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .toolbar__emoji:hover {
    background: rgb(255 255 255 / 0.08);
  }

  .toolbar__emoji[aria-pressed='true'] {
    background: rgb(255 255 255 / 0.18);
  }

  .toolbar__hand {
    display: grid;
    place-items: center;
    flex: 0 1 52px;
    min-width: 0;
    height: 52px;
    padding: 0;
    border: 0;
    border-radius: 10px;
    /* the turned hand's stick runs out at the button's edge */
    overflow: hidden;
    background: transparent;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .toolbar__hand:hover {
    background: rgb(255 255 255 / 0.08);
  }

  .toolbar__hand[aria-pressed='true'] {
    background: rgb(255 255 255 / 0.18);
  }

  .toolbar__divider {
    flex: none;
    width: 1px;
    height: 32px;
    margin-inline: 4px;
    background: rgb(255 255 255 / 0.2);
  }

  .toolbar__add {
    display: grid;
    place-items: center;
    flex: 0 1 52px;
    min-width: 0;
    height: 52px;
    padding: 0;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--color-white);
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .toolbar__add:hover,
  .toolbar__add:focus-visible {
    background: rgb(255 255 255 / 0.08);
  }

  .toolbar__add svg {
    width: 22px;
  }

  .toolbar__hand[hidden] {
    display: none;
  }

  /* the app's grid tile: the hand turned, its stick to the edge, filling the button */
  .toolbar__hand :global(img) {
    width: 52px;
    height: 52px;
    object-fit: cover;
  }
</style>
